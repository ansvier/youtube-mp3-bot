# Set the two required values locally. Never share credentials in chat or Git.
BOT_TOKEN=
ALLOWED_USER_IDS=

# One active request per user; total concurrent conversions across all users.
MAX_CONCURRENT_DOWNLOADS=1
QUEUE_SIZE=5
RATE_LIMIT_SECONDS=30
DOWNLOAD_TIMEOUT=600
CONVERSION_TIMEOUT=300
UPLOAD_TIMEOUT=300
DEFAULT_AUDIO_BITRATE=192

# Empty = 50 MB for the cloud API or 2000 MB for a trusted local Bot API.
# MB = 1,000,000 bytes. The cloud API cannot be configured above 50 MB.
MAX_FILE_SIZE_MB=
MAX_SOURCE_SIZE_MB=512
TEMP_DIR=/tmp/mp3-bot
LOG_LEVEL=INFO

# Optional Netscape cookies file; see README before enabling it.
# Path INSIDE the worker container, e.g. /run/cookies/youtube.txt.
COOKIES_FILE=
# Absolute path on the Docker HOST, only for compose.cookies.yml.
COOKIES_HOST_FILE=

# Empty = https://api.telegram.org. Local example: http://telegram-bot-api:8081
TELEGRAM_API_BASE_URL=
